# ============================================================
# ChangeTrace Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# Azure Subscription & Resource Group
# ------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=changetrace-rg
AZURE_LOCATION=eastus

# ------------------------------------------------------------
# Cosmos DB (Gremlin API) - Dependency Graph
# ------------------------------------------------------------
COSMOS_DB_ENDPOINT=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=changetrace-graph
COSMOS_DB_GRAPH=dependency-graph
COSMOS_DB_TRAINING_CONTAINER=training-data

# ------------------------------------------------------------
# Azure Monitor / Application Insights / Log Analytics
# ------------------------------------------------------------
LOG_ANALYTICS_WORKSPACE_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=

# ------------------------------------------------------------
# Azure Machine Learning Endpoints
# ------------------------------------------------------------
# Confidence Model (Root Cause Ranking)
ML_SCORING_ENDPOINT=
ML_SCORING_KEY=

# Risk Model (Deployment Risk Scoring)
ML_RISK_ENDPOINT=
ML_RISK_KEY=

# ------------------------------------------------------------
# Argo Rollouts API (for canary deployments & rollbacks)
# ------------------------------------------------------------
ARGO_API_URL=
ARGO_API_TOKEN=

# ------------------------------------------------------------
# Notification Channels
# ------------------------------------------------------------
# Teams Webhook for approval requests
TEAMS_WEBHOOK_URL=

# SendGrid for email notifications
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=changetrace@company.com
ONCALL_EMAIL=oncall@company.com

# ------------------------------------------------------------
# Azure Key Vault (for secrets)
# ------------------------------------------------------------
KEY_VAULT_NAME=
KEY_VAULT_URI=

# ------------------------------------------------------------
# Event Grid Topics
# ------------------------------------------------------------
EVENT_GRID_CUSTOM_TOPIC_ENDPOINT=
EVENT_GRID_CUSTOM_TOPIC_KEY=

# ------------------------------------------------------------
# Storage Account (Terraform state, function artifacts)
# ------------------------------------------------------------
STORAGE_ACCOUNT_NAME=
STORAGE_ACCOUNT_KEY=

# ------------------------------------------------------------
# Container Registry
# ------------------------------------------------------------
ACR_NAME=
ACR_LOGIN_SERVER=

# ------------------------------------------------------------
# AKS Cluster
# ------------------------------------------------------------
AKS_CLUSTER_NAME=changetrace-aks
AKS_RESOURCE_GROUP=changetrace-rg

# ------------------------------------------------------------
# Chaos Studio
# ------------------------------------------------------------
CHAOS_STUDIO_RESOURCE_GROUP=changetrace-rg

# ------------------------------------------------------------
# Optional: LLM for Postmortem Reports
# ------------------------------------------------------------
USE_LLM_FOR_REPORTS=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# ------------------------------------------------------------
# Optional: Risk Model Path (local file)
# ------------------------------------------------------------
RISK_MODEL_PATH=

# ------------------------------------------------------------
# Optional: GitHub Integration
# ------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=

# ------------------------------------------------------------
# Optional: Terraform Backend
# ------------------------------------------------------------
TF_STATE_RESOURCE_GROUP=changetrace-tfstate-rg
TF_STATE_STORAGE_ACCOUNT=changetracetfstate
TF_STATE_CONTAINER=tfstate
TF_STATE_KEY=changetrace.tfstate